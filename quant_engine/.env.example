# 基础配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Redis密码(如有)
REDIS_SSL=false  # 是否启用SSL连接
API_HOST=0.0.0.0
API_PORT=8000
API_AUTH_TOKEN=  # API认证Token(留空则跳过认证)
DATA_SOURCE=tushare
TUSHARE_TOKEN=your_tushare_token_here

# 钉钉配置
# 获取方式: 钉钉群设置 -> 智能群助手 -> 添加机器人 -> 自定义
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token_here
DINGTALK_SECRET=your_secret_here

# AI配置
# DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 云知声 U2（主力模型，D56 起）—— https://maas.unisound.com
# 获取：maas.unisound.com 控制台注册 → Token Hub → 创建 API Key（sk- 开头）
# 端点两套都可用：OpenAI 兼容 /v1  与 Anthropic 原生 /anthropic/v1
UNISOUND_API_KEY=your_unisound_api_key_here
UNISOUND_BASE_URL=https://maas-api.unisound.com/v1
UNISOUND_MODEL=u2
# 思考型模型：思考 token 也计入 max_tokens，给小了会返回 content=null
# （finish_reason=length，正文全丢）。2500 实测足够覆盖 500 字总结。
UNISOUND_MAX_TOKENS=2500

# 问财选股（可选，不进盘中主循环）—— iwencai.com 登录后 devtools 复制
# HEXIN_V：pywencai 的 hexin-v.js 生成（node hexin-v.bundle.js）
# IWENCAI_COOKIE：浏览器 devtools → Network → 任意 iwencai 请求 → Cookie 头
# D55 实测：Hexin-V 与 Cookie 任意一个即可过风控，Cookie 可留空
HEXIN_V=
IWENCAI_COOKIE=

# 企业微信配置（可选）
# 获取方式: 企业微信管理后台 -> 群机器人配置
WECHAT_WEBHOOK_URL=

# 飞书配置（可选）
# 获取方式: 飞书群设置 -> 群机器人 -> 添加机器人
FEISHU_WEBHOOK_URL=

# Telegram配置（可选）
# 获取方式: 联系@BotFather创建机器人
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 新闻搜索配置（可选）
# SERPAPI: https://serpapi.com/
SERPAPI_API_KEY=
# TAVILY: https://tavily.com/
TAVILY_API_KEY=
# 基础配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=  # Redis密码(如有)
REDIS_SSL=false  # 是否启用SSL连接
API_HOST=0.0.0.0
API_PORT=8000
# P0-1：留空 = 所有 API/WS 匿名开放。生产必须设置（前端 fetchAPI 从浏览器
# localStorage 读 sm_api_key 并带 X-API-Key；WS 带 ?token=）。设了 token 就
# 必须同步告知使用者在 UX 页面录入，否则 UI 会全部 401。
API_AUTH_TOKEN=
# DATA_SOURCE 是遗留字段（代码零引用），保留仅为兼容旧配置
DATA_SOURCE=tushare
# TUSHARE_TOKEN 本地已空置：主数据源为东财/新浪/腾讯，不需要它
TUSHARE_TOKEN=

# ===== D66/D68/D69 数据质量与反封禁开关（不写则取代码默认值）=====
EM_GLOBAL_THROTTLE=true       # D68 跨进程全局限速（三服务共享 Redis 预约）
INTRADAY_KLINE_CORRECTION=true # D65 盘中日K实时修正
KLINE_CROSS_CHECK=true        # D66 疑似降级时独立源复核
KLINE_EOD_SEAL=true           # D66 收盘封存
KLINE_DAY_BOUNDARY_GUARD=true # D66 隔夜 stale 快照作废
SOURCE_TIMEOUT_SUPPRESSION=true # I-05 超时抑制
AI_PARTIAL_NOTIFY=true        # I-11 AI 部分结果仍推送
KLINE_REJECT_STALE_FRAME=false # I-04 整帧拒绝层（策略行为变更，需裁定）
DAILY_REPORT_DISCIPLINE_DIMENSION=false # I-08 日报纪律维度（需裁定）
STALE_QUOTE_REJECT_SECONDS=0  # D69 陈旧报价硬拒绝（秒；0=关闭，>0 会改信号，需 D41+裁定）

# 钉钉配置
# 获取方式: 钉钉群设置 -> 智能群助手 -> 添加机器人 -> 自定义
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=your_token_here
DINGTALK_SECRET=your_secret_here

# AI配置
# DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 云知声 U2-flash（主力模型，D56 引入 / D70 显式指定）—— https://maas.unisound.com
# 获取：maas.unisound.com 控制台注册 → Token Hub → 创建 API Key（sk- 或 tp- 开头）
# 端点两套都可用：OpenAI 兼容 /v1  与 Anthropic 原生 /anthropic/v1
UNISOUND_API_KEY=your_unisound_api_key_here
UNISOUND_BASE_URL=https://maas-api.unisound.com/v1
UNISOUND_MODEL=u2-flash   # 主力模型；可选 u2-flash / u2 / u2-med
# 思考型模型：思考 token 也计入 max_tokens，给小了会返回 content=null
# （finish_reason=length，正文全丢）。D69 实证 2500 不足（ECS 近7天 3 次空正文
# + 级联降级），上调至 6000；ECS 部署 .env 也必须同步改这一行。
UNISOUND_MAX_TOKENS=6000

# 问财选股（可选，不进盘中主循环）—— iwencai.com 登录后 devtools 复制
# HEXIN_V：pywencai 的 hexin-v.js 生成（node hexin-v.bundle.js）
# IWENCAI_COOKIE：浏览器 devtools → Network → 任意 iwencai 请求 → Cookie 头
# D55 实测：Hexin-V 与 Cookie 任意一个即可过风控，Cookie 可留空
HEXIN_V=
IWENCAI_COOKIE=

# 企业微信配置（可选）
# 获取方式: 企业微信管理后台 -> 群机器人配置
WECHAT_WEBHOOK_URL=

# 飞书配置（可选）
# 获取方式: 飞书群设置 -> 群机器人 -> 添加机器人
FEISHU_WEBHOOK_URL=

# Telegram配置（可选）
# 获取方式: 联系@BotFather创建机器人
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 新闻搜索配置（可选）
# SERPAPI: https://serpapi.com/
SERPAPI_API_KEY=
# TAVILY: https://tavily.com/
TAVILY_API_KEY=
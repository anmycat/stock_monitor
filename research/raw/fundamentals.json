  "_meta": {
    "desc": "27只股票（主池17+扩展池10）的 point-in-time 基本面数据。来源：neodata financial_indicators。用途：市赚率PR=PE_TTM/ROE_TTM/100 计算。",
    "discipline": "point-in-time：T日信号只能用T日已发布的报告。FY2025年报（2026-03/04发布）全窗口可用；2026中报（2026-08发布）仅在各自发布日后用于滚动TTM",
    "ttm_formula": "EPS_TTM = FY2025_EPS + H1_2026_EPS - H1_2025_EPS（中报发布后）；ROE_TTM 用同口径加权ROE相加近似",
    "fields": {
      "eps_fy25": "2025年报基本每股收益",
      "roe_fy25": "2025年报加权ROE(%)",
      "eps_h1_26": "2026中报基本每股收益",
      "roe_h1_26": "2026中报加权ROE(%)",
      "eps_h1_25": "2025中报基本每股收益（TTM滚动用）",
      "roe_h1_25": "2025中报加权ROE(%)（TTM滚动用）",
      "h1_26_pub": "2026中报发布日（此前用FY2025口径）"
    },
    "data_quality_note": "neodata valuation 接口的 pe_ttm 快照与行情价格基准不一致（000011快照pe_ttm=5.0，按FY2025 EPS反推应为~206；其扣非PE=-117.44恰好对应价格2.44，判定为陈旧/错误快照）——故PE一律用本文件EPS×行情收盘价自算，不用估值接口快照"
  },
